@ ==== 2.1-16: ETHAN or LYRA in person (lane A) ====
@ Your childhood friend (2.1-15) is already in a town when you first walk in:
@ VIOLET, AZALEA, GOLDENROD, ECRUTEAK and OLIVINE in Johto, VERMILION, CERULEAN
@ and PEWTER in Kanto. They spot you (their object is a "trainer" whose script
@ isn't a battle, so it walks up like a fake fight), give a tip about the
@ place and move along. After all eight Kanto badges, the next time you walk
@ into PROF. OAK's lab they tell him they'll stay on as his field aide (Aidan),
@ and they work there from then on. Which scene is out: HoennNeighborTownArm
@ (src/hoenn_2_1_lane_a.c), from each map's OnTransition.
@ Generated by a scratch script; the text is checked by text_audit.py.

HoennSeek_EventScript_NeighborTownArmViolet::
	setvar VAR_0x8004, HOENN_NEIGHBOR_TOWN_VIOLET
	goto HoennSeek_EventScript_NeighborTownArm
HoennSeek_EventScript_NeighborTownArmAzalea::
	setvar VAR_0x8004, HOENN_NEIGHBOR_TOWN_AZALEA
	goto HoennSeek_EventScript_NeighborTownArm
HoennSeek_EventScript_NeighborTownArmGoldenrod::
	setvar VAR_0x8004, HOENN_NEIGHBOR_TOWN_GOLDENROD
	goto HoennSeek_EventScript_NeighborTownArm
HoennSeek_EventScript_NeighborTownArmEcruteak::
	setvar VAR_0x8004, HOENN_NEIGHBOR_TOWN_ECRUTEAK
	goto HoennSeek_EventScript_NeighborTownArm
HoennSeek_EventScript_NeighborTownArmOlivine::
	setvar VAR_0x8004, HOENN_NEIGHBOR_TOWN_OLIVINE
	goto HoennSeek_EventScript_NeighborTownArm
HoennSeek_EventScript_NeighborTownArmVermilion::
	setvar VAR_0x8004, HOENN_NEIGHBOR_TOWN_VERMILION
	goto HoennSeek_EventScript_NeighborTownArm
HoennSeek_EventScript_NeighborTownArmCerulean::
	setvar VAR_0x8004, HOENN_NEIGHBOR_TOWN_CERULEAN
	goto HoennSeek_EventScript_NeighborTownArm
HoennSeek_EventScript_NeighborTownArmPewter::
	setvar VAR_0x8004, HOENN_NEIGHBOR_TOWN_PEWTER
	goto HoennSeek_EventScript_NeighborTownArm
HoennSeek_EventScript_NeighborTownArm:
	call HoennSeek_EventScript_NeighborSetGfx
	specialvar VAR_RESULT, HoennNeighborTownArm
	return

@ GOLDENROD had no map scripts.
HoennSeek_EventScript_GoldenrodOnTransition::
	call HoennSeek_EventScript_NeighborTownArmGoldenrod
	end

HoennSeek_EventScript_NeighborTownViolet::
	setvar VAR_0x8004, HOENN_NEIGHBOR_TOWN_VIOLET
	goto HoennSeek_EventScript_NeighborTown
HoennSeek_EventScript_NeighborTownAzalea::
	setvar VAR_0x8004, HOENN_NEIGHBOR_TOWN_AZALEA
	goto HoennSeek_EventScript_NeighborTown
HoennSeek_EventScript_NeighborTownGoldenrod::
	setvar VAR_0x8004, HOENN_NEIGHBOR_TOWN_GOLDENROD
	goto HoennSeek_EventScript_NeighborTown
HoennSeek_EventScript_NeighborTownEcruteak::
	setvar VAR_0x8004, HOENN_NEIGHBOR_TOWN_ECRUTEAK
	goto HoennSeek_EventScript_NeighborTown
HoennSeek_EventScript_NeighborTownOlivine::
	setvar VAR_0x8004, HOENN_NEIGHBOR_TOWN_OLIVINE
	goto HoennSeek_EventScript_NeighborTown
HoennSeek_EventScript_NeighborTownVermilion::
	setvar VAR_0x8004, HOENN_NEIGHBOR_TOWN_VERMILION
	goto HoennSeek_EventScript_NeighborTown
HoennSeek_EventScript_NeighborTownCerulean::
	setvar VAR_0x8004, HOENN_NEIGHBOR_TOWN_CERULEAN
	goto HoennSeek_EventScript_NeighborTown
HoennSeek_EventScript_NeighborTownPewter::
	setvar VAR_0x8004, HOENN_NEIGHBOR_TOWN_PEWTER
	goto HoennSeek_EventScript_NeighborTown
@ The tip (callnative marks the scene done), then they move along.
HoennSeek_EventScript_NeighborTown:
	lock
	faceplayer
	call HoennSeek_EventScript_NeighborSpeaker
	callnative HoennSeek_NeighborTownText
	callstd MSGBOX_DEFAULT
	closemessage
	specialvar VAR_RESULT, HoennNeighborLeaveDir
	call_if_eq VAR_RESULT, DIR_NORTH, HoennSeek_EventScript_NeighborLeaveNorth
	call_if_eq VAR_RESULT, DIR_SOUTH, HoennSeek_EventScript_NeighborLeaveSouth
	call_if_eq VAR_RESULT, DIR_WEST, HoennSeek_EventScript_NeighborLeaveWest
	call_if_eq VAR_RESULT, DIR_EAST, HoennSeek_EventScript_NeighborLeaveEast
	removeobject VAR_LAST_TALKED
	release
	end
HoennSeek_EventScript_NeighborLeaveNorth:
	applymovement VAR_LAST_TALKED, HoennSeek_Movement_NeighborLeaveNorth
	waitmovement 0
	return
HoennSeek_EventScript_NeighborLeaveSouth:
	applymovement VAR_LAST_TALKED, HoennSeek_Movement_NeighborLeaveSouth
	waitmovement 0
	return
HoennSeek_EventScript_NeighborLeaveWest:
	applymovement VAR_LAST_TALKED, HoennSeek_Movement_NeighborLeaveWest
	waitmovement 0
	return
HoennSeek_EventScript_NeighborLeaveEast:
	applymovement VAR_LAST_TALKED, HoennSeek_Movement_NeighborLeaveEast
	waitmovement 0
	return
HoennSeek_Movement_NeighborLeaveNorth:
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_up
	step_end
HoennSeek_Movement_NeighborLeaveSouth:
	walk_fast_down
	walk_fast_down
	walk_fast_down
	walk_fast_down
	step_end
HoennSeek_Movement_NeighborLeaveWest:
	walk_fast_left
	walk_fast_left
	walk_fast_left
	walk_fast_left
	step_end
HoennSeek_Movement_NeighborLeaveEast:
	walk_fast_right
	walk_fast_right
	walk_fast_right
	walk_fast_right
	step_end

@ ---- PROF. OAK's lab: they decide to stay (after all eight Kanto badges) ----
HoennSeek_EventScript_OaksLabOnTransition::
	setvar VAR_0x8004, HOENN_NEIGHBOR_TOWN_OAKS_LAB
	call HoennSeek_EventScript_NeighborTownArm
	goto_if_eq VAR_RESULT, FALSE, HoennSeek_EventScript_OaksLabOnTransitionEnd
	goto_if_set FLAG_HOENN_NEIGHBOR_STAYED, HoennSeek_EventScript_OaksLabOnTransitionEnd
	setvar VAR_TEMP_1, 1
HoennSeek_EventScript_OaksLabOnTransitionEnd:
	end

HoennSeek_OaksLabFrameTable::
	map_script_2 VAR_TEMP_1, 1, HoennSeek_EventScript_OaksLabScene
	.2byte 0

HoennSeek_EventScript_OaksLabScene::
	lockall
	setvar VAR_TEMP_1, 0
	call HoennSeek_EventScript_NeighborSpeaker
	playse SE_PIN
	applymovement LOCALID_HOENN_OAKS_LAB_NEIGHBOR, Common_Movement_ExclamationMark
	waitmovement 0
	applymovement LOCALID_HOENN_OAKS_LAB_NEIGHBOR, Common_Movement_FaceDown
	waitmovement 0
	msgbox HoennSeek_Text_LabHello, MSGBOX_DEFAULT
	closemessage
	getplayerxy VAR_0x8005, VAR_0x8006
	goto_if_ne VAR_0x8005, 13, HoennSeek_EventScript_OaksLabSceneTalk
HoennSeek_EventScript_OaksLabSceneWalk:
	getplayerxy VAR_0x8005, VAR_0x8006
	goto_if_le VAR_0x8006, 13, HoennSeek_EventScript_OaksLabSceneTalk
	applymovement OBJ_EVENT_ID_PLAYER, Common_Movement_WalkUp
	waitmovement 0
	goto HoennSeek_EventScript_OaksLabSceneWalk
HoennSeek_EventScript_OaksLabSceneTalk:
	applymovement LOCALID_HOENN_OAKS_LAB_NEIGHBOR, Common_Movement_FaceUp
	waitmovement 0
	setspeaker HoennSeek_Text_NameOak
	msgbox HoennSeek_Text_LabOakAsks, MSGBOX_DEFAULT
	call HoennSeek_EventScript_NeighborSpeaker
	msgbox HoennSeek_Text_LabDecision, MSGBOX_DEFAULT
	setspeaker HoennSeek_Text_NameOak
	msgbox HoennSeek_Text_LabOakSplendid, MSGBOX_DEFAULT
	closemessage
	applymovement LOCALID_HOENN_OAKS_LAB_NEIGHBOR, Common_Movement_FaceDown
	waitmovement 0
	call HoennSeek_EventScript_NeighborSpeaker
	msgbox HoennSeek_Text_LabToPlayer, MSGBOX_DEFAULT
	setflag FLAG_HOENN_NEIGHBOR_STAYED
	closemessage
	releaseall
	end

@ Talking to them in the lab afterwards.
HoennSeek_EventScript_OaksLabNeighbor::
	lock
	faceplayer
	call HoennSeek_EventScript_NeighborSpeaker
	msgbox HoennSeek_Text_LabAide, MSGBOX_DEFAULT
	release
	end

HoennSeek_Text_NeighborTownViolet::
	.string "{PLAYER}! You made it to VIOLET!\p"
	.string "I'm counting the HOOTHOOT that\n"
	.string "roost on the SPROUT TOWER.\p"
	.string "FALKNER's GYM is all bird\n"
	.string "POKéMON. ROCK and ELECTRIC moves\l"
	.string "work great on them.\p"
	.string "The monks in the tower battle\n"
	.string "with BELLSPROUT. It's good\l"
	.string "practice before the GYM!\p"
	.string "Okay, the HOOTHOOT won't count\n"
	.string "themselves. See you!$"

HoennSeek_Text_NeighborTownAzalea::
	.string "{PLAYER}! Welcome to AZALEA!\p"
	.string "Want to know a secret? KURT lives\n"
	.string "here, and he turns APRICORNs into\l"
	.string "POKé BALLS.\p"
	.string "The APRICORN trees by the roads\n"
	.string "grow a new one every day. Bring\l"
	.string "him some!\p"
	.string "The SLOWPOKE here are acting odd,\n"
	.string "so I'm off to check the WELL. Bye!$"

HoennSeek_Text_NeighborTownGoldenrod::
	.string "{PLAYER}! Isn't GOLDENROD huge?\p"
	.string "Two things to know. The DAY-CARE\n"
	.string "on ROUTE 34 raises your POKéMON\l"
	.string "while you're away.\p"
	.string "And there's a BUG-CATCHING\n"
	.string "CONTEST at the NATIONAL PARK\l"
	.string "every day. I won once!\p"
	.string "I'm taking PROF. ELM's notes to\n"
	.string "the RADIO TOWER. See you!$"

HoennSeek_Text_NeighborTownEcruteak::
	.string "{PLAYER}! Look at the towers in\n"
	.string "ECRUTEAK! Aren't they amazing?\p"
	.string "The BURNED TOWER burned down long\n"
	.string "ago. People say three POKéMON\l"
	.string "ran out of the fire.\p"
	.string "Oh, and if a POKéMON knows\n"
	.string "HEADBUTT, try it on trees.\l"
	.string "Sleeping POKéMON fall out!\p"
	.string "I'm off to sketch the BELL TOWER\n"
	.string "before the sun goes down. Bye!$"

HoennSeek_Text_NeighborTownOlivine::
	.string "{PLAYER}! Smell that sea air!\p"
	.string "JASMINE's at the top of the\n"
	.string "LIGHTHOUSE. Her AMPHAROS lights\l"
	.string "the way for the ships.\p"
	.string "Once you can SURF, the sea has\n"
	.string "its own POKéMON. Fish with a ROD\l"
	.string "and you'll find even more!\p"
	.string "I'm going down to the docks to\n"
	.string "watch the TENTACOOL. See you!$"

HoennSeek_Text_NeighborTownVermilion::
	.string "{PLAYER}! Welcome to KANTO!\p"
	.string "I'm helping PROF. OAK now, so I\n"
	.string "get to explore all of it!\p"
	.string "Here's a scoop. Some mornings, a\n"
	.string "gang of SQUIRTLE plays by the\l"
	.string "pond on ROUTE 6, just north of\l"
	.string "here. Watch your step there!\p"
	.string "Okay, I'm heading back to PALLET\n"
	.string "TOWN. Bye!$"

HoennSeek_Text_NeighborTownCerulean::
	.string "{PLAYER}! I was hoping I'd run\n"
	.string "into you in CERULEAN!\p"
	.string "I saw something sad up past\n"
	.string "NUGGET BRIDGE one evening.\p"
	.string "A CHARMANDER, sitting all alone\n"
	.string "in the rain.\p"
	.string "It looked like it was waiting for\n"
	.string "someone. Maybe you can help it?\p"
	.string "I've got to take these notes to\n"
	.string "BILL. See you!$"

HoennSeek_Text_NeighborTownPewter::
	.string "{PLAYER}! PEWTER is so quiet,\n"
	.string "isn't it? I came to see the\l"
	.string "MUSEUM's fossils.\p"
	.string "Here's a scoop for you. The\n"
	.string "CLEFAIRY in MT. MOON dance on\l"
	.string "MONDAY nights.\p"
	.string "PROF. OAK's been trying to see it\n"
	.string "for years. Tell me if you do!\p"
	.string "Back to PALLET for me. Bye!$"

HoennSeek_Text_LabHello:
	.string "{PLAYER}! Perfect timing!\n"
	.string "Come here, come here!$"

HoennSeek_Text_LabOakAsks:
	.string "Ah, {PLAYER}! All eight KANTO\n"
	.string "BADGES. Splendid work!\p"
	.string "Now then. Have you thought about\n"
	.string "my offer? I'd love to keep you on\l"
	.string "as my field aide.$"

HoennSeek_Text_LabDecision:
	.string "I have, PROF. OAK.\p"
	.string "I called PROF. ELM last night,\n"
	.string "and he said it's a great chance\l"
	.string "for me.\p"
	.string "So… yes! I'd love to stay in\n"
	.string "KANTO and work with you.$"

HoennSeek_Text_LabOakSplendid:
	.string "Wonderful! KANTO's POKéMON are\n"
	.string "lucky to have you.\p"
	.string "ELM always said you were the\n"
	.string "best field helper he ever had.\l"
	.string "I'll take good care of you.$"

HoennSeek_Text_LabToPlayer:
	.string "So that's it, {PLAYER}. I'm staying\n"
	.string "here in KANTO.\p"
	.string "You're going to HOENN next,\n"
	.string "aren't you? I won't see you\l"
	.string "much over there…\p"
	.string "But call me, okay? Take lots of\n"
	.string "notes. I want to hear everything!$"

HoennSeek_Text_LabAide:
	.string "I'm PROF. OAK's field aide now!\n"
	.string "He keeps me so busy.\p"
	.string "How's your adventure going? Tell\n"
	.string "me everything when you call!$"

